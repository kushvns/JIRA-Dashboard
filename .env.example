# Copy to .env.local for local development (vercel dev). Never commit real values.
# On Vercel, add the same names under Project Settings -> Environment Variables.

# Your Jira Cloud site, no trailing slash
JIRA_BASE_URL=https://your-company.atlassian.net

# An Atlassian account that can browse the SE and IN projects, and an API token for it
# Create the token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=you@your-company.com
JIRA_API_TOKEN=

# --- Access control: pick ONE ---
# A) Microsoft 365 sign-in, only @rategain.com users (recommended). See README "Company-only access".
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Long random string used to sign login cookies, e.g. output of: openssl rand -base64 32
SESSION_SECRET=
# Optional: allowed e-mail domain (default rategain.com) and the public URL of the dashboard
# ALLOWED_EMAIL_DOMAIN=rategain.com
# APP_URL=https://your-dashboard.vercel.app

# B) Simple shared password (used only when the MS_* values above are empty).
# If both A and B are empty, anyone with the URL can see your ticket data.
DASHBOARD_PASSWORD=

# Optional overrides (defaults shown)
# DASHBOARD_TZ=Asia/Kolkata
# JIRA_QUEUE_FIELD=customfield_15446
# JIRA_SLA_FIELD=customfield_10703
